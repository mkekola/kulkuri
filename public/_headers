# Netlify reads this file from the published directory.
#
# Everything Vite emits into /assets/ carries a content hash in its filename,
# so a given URL can never change meaning: it is safe to keep for a year and
# never revalidate. Without this, Netlify's default (max-age=0,
# must-revalidate) makes every visit pay a round trip per file before it can
# use what it already has.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# maplibre-gl's worker and its shared chunk are copied in verbatim by
# scripts/copy-maplibre-assets.mjs and keep their original names, because the
# worker resolves its sibling by a relative URL at runtime. No hash means no
# immutable caching - a maplibre-gl upgrade reuses these exact names, and a
# year-long cache would hide the new version from anyone holding the old one.
/maplibre/*
  Cache-Control: public, max-age=3600
